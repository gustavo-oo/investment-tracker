{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "flash",
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "instructions": [
    ".opencode/instructions/i-have-adhd.md"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "agent-browser": {
      "type": "local",
      "command": [
        "agent-browser",
        "mcp"
      ],
      "enabled": true
    }
  }
}
